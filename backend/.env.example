# ================= CotiScola — Backend =================
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Base de données PostgreSQL
DATABASE_URL=postgresql://cotisa:cotisa@localhost:5432/cotisations_db
# (pour db:init uniquement) accès administrateur PostgreSQL
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Email SMTP — Gmail avec mot de passe d'application, ou Brevo/Mailgun.
# Laissez vide pour désactiver l'envoi d'emails (le reste de l'app fonctionne).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CotiScola <ecole@example.mg>"

# Établissement (en-tête des reçus et rapports PDF)
ETAB_NOM="Établissement Scolaire"
ETAB_ADRESSE="Antananarivo, Madagascar"
ETAB_CONTACT="Tél. 03XX XXXXX"

# Arrondi des frais de transfert (RG10) — millier supérieur
ARRONDI_PAS=1000
